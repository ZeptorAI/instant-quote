# --- GWS Instant Quote environment ---

# SQLite database file (relative to the /prisma directory).
# Swap this for a Postgres connection string when you migrate later.
DATABASE_URL="file:./dev.db"

# Shared password that gates the /admin portal (checked in middleware).
ADMIN_PASSWORD="gws-admin"

# Outbound webhook that every accepted quote request is forwarded to.
# Use https://webhook.site to get a throwaway URL for testing.
QUOTE_WEBHOOK_URL="https://webhook.site/your-uuid-here"
